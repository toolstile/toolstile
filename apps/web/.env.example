DATABASE_URL=pglite:replace-with-absolute-data-directory
BETTER_AUTH_URL=http://127.0.0.1:4310
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Optional social sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Operator OAuth clients for MCP servers without dynamic registration: a JSON list of
# {"origin","env","issuer"}; each reads <env>_CLIENT_ID and <env>_CLIENT_SECRET. Unset, it is
# GitHub's MCP server (origin https://api.githubcopilot.com, env GITHUB_MCP).
UPSTREAM_OAUTH_CLIENTS=
# Optional instance-owned GitHub MCP OAuth client (separate from dashboard sign-in)
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
# Optional email verification/recovery delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional explicitly selected HTTPS telemetry receiver; see docs/telemetry.md.
TOOLSTILE_TELEMETRY_URL=

# Connector catalog: fetched from www.toolstile.com by default; off uses only the bundled
# snapshot. See docs/connector-catalog.md#catalog-source.
TOOLSTILE_CATALOG_URL=
TOOLSTILE_CATALOG_FETCH=
